# Local development runtime configuration.
# Copy to .env and adjust values for your machine. Production must use
# .env.prod.example / secret manager values instead of these local defaults.

DB_URL=jdbc:postgresql://localhost:5433/switching_db
DB_USERNAME=macbookpro
DB_PASSWORD=

FLYWAY_URL=jdbc:postgresql://localhost:5433/switching_db
FLYWAY_USERNAME=macbookpro
FLYWAY_PASSWORD=

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SERVER_PORT=8080

ARCHIVE_DB_URL=jdbc:postgresql://localhost:5434/switching_archive
ARCHIVE_DB_USERNAME=switching_archive
ARCHIVE_DB_PASSWORD=__INJECT_AT_RUNTIME__
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=switching-archive
OBJECT_STORAGE_ACCESS_KEY=__INJECT_AT_RUNTIME__
OBJECT_STORAGE_SECRET_KEY=__INJECT_AT_RUNTIME__

BOL_RTGS_URL=http://localhost:9099/rtgs/pacs009
BOL_FIU_URL=http://localhost:9099/fiu
BOL_FIU_API_KEY=
AML_BOL_SANCTIONS_API_KEY=
AML_OFAC_SANCTIONS_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
AML_UN_SANCTIONS_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml

PROMPTPAY_API_URL=http://mock-promptpay:9099/promptpay
CNAPS_API_URL=http://mock-cnaps:9099/cnaps
NAPAS_API_URL=http://mock-napas:9099/napas
SWIFT_API_URL=http://mock-swift:9099/swift
SWIFT_BIC=BFILLALAXXX

MESSAGE_CRYPTO_KEY_BASE64=
OAUTH_JWT_SECRET=
SMOS_JWT_SECRET=
WEBHOOK_LOCAL_MASTER_KEY_BASE64=

# Optional local/UAT CA issuer for Admin Portal CSR -> CRT issuance.
# Paths are resolved inside the Switching app runtime/container.
CERT_ISSUER_OPENSSL_BIN=openssl
CERT_ISSUER_CA_CERT_PATH=
CERT_ISSUER_CA_KEY_PATH=
CERT_ISSUER_VALIDITY_DAYS=365
